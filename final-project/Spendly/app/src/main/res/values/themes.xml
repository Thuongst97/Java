         wallpaper-based palette. values-night/themes.xml provides the dark variant. -->
    <style name="Theme.Spendly" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">#006A60</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#74F8E5</item>
        <item name="colorOnPrimaryContainer">#00201C</item>
        <item name="colorSecondaryContainer">#CCE8E2</item>
        <item name="colorOnSecondaryContainer">#05201C</item>
    </style>
</resources>
